# Non-secret development reference values; copy to the ignored .env file before setting a local key.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ALLOWED_ORIGIN=http://127.0.0.1:5173
AUTODUB_GEMINI_API_KEY=
# Optional multi-key JSON configuration (backend only; uncomment and replace placeholders).
# Keys in the same quota_group are treated as sharing provider capacity; 429 never rotates keys.
# AUTODUB_GEMINI_CREDENTIALS_JSON=[{"alias":"primary","api_key":"REPLACE_ME","quota_group":"project-a","priority":1,"enabled":true}]
# Optional one-time recovery after replacing a key under an alias previously marked AUTH_FAILED.
# Set to a comma-separated list of configured aliases, restart backend, then remove the setting.
# AUTODUB_GEMINI_REVALIDATE_ALIASES=primary
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Gemini key is read only by the backend process and is never stored in SQLite or frontend assets.
# Edge-TTS configuration belongs to a later stage.
